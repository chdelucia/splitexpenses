{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": ["es2020", "dom"],
    "strict": true,
    "ignoreDeprecations": "6.0",
    "types": ["@angular/localize"],
    "paths": {
      "@core/*": ["libs/shared/src/lib/core/*"],
      "@debts/*": ["libs/shared/src/lib/debts/*"],
      "@expenses/*": ["libs/shared/src/lib/expenses/*"],
      "@forecast/*": ["libs/shared/src/lib/forecast/*"],
      "@settings/*": ["libs/shared/src/lib/settings/*"],
      "@shared/*": ["libs/shared/src/lib/shared/*"],
      "@state/*": ["libs/shared/src/lib/state/*"],
      "@stats/*": ["libs/shared/src/lib/stats/*"],
      "@users/*": ["libs/shared/src/lib/users/*"],
      "@weather/*": ["libs/shared/src/lib/weather/*"],
      "@env/*": ["libs/shared/src/environments/*"],
      "shared": ["libs/shared/src/index.ts"]
    }
  }
}