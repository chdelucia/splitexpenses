{
  "name": "splitexpenses",
  "version": "1.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration=en",
    "build": "ng build",
    "build:translation": "ng build --configuration production --base-href='https://chdelucia.github.io/splitexpenses/' --localize",
    "deploy:pro": "npx angular-cli-ghpages --dir=dist",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "ng test --watch",
    "sonar": "sonar-scanner",
    "lint": "ng lint",
    "update-hooks": "simple-git-hooks",
    "pre-commit": "",
    "pre-push": "",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "prettier:write": "npx prettier --write .",
    "postinstall": "node patch-node-version-check.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@ngrx/store": "22.0.0-beta.0",
    "@ngrx/store-devtools": "22.0.0-beta.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "ngx-skeleton-loader": "^13.0.0",
    "rxjs": "7.8.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.8",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/localize": "22.1.0",
    "@compodoc/compodoc": "1.2.1",
    "@cypress/schematic": "5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "22.0.0-beta.0",
    "@ngrx/schematics": "22.0.0-beta.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "angular-eslint": "^22.1.0",
    "cypress": "^15.16.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "simple-git-hooks": "^2.13.1",
    "sonar-scanner": "^3.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*spec.ts": [
      "jest"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
